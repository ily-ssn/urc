    "test": "node tests/api.mjs && npm run test:db"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "jsqr": "1.4.0",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "esbuild": "0.25.12"
  }
}
